{
  "name": "jobleft",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "jobleft: a local-first desktop job-search app. Workspace root. MIT (see LICENSE).",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm test",
    "app:up": "node scripts/app-up.ts",
    "app:down": "node scripts/app-down.ts",
    "gen:interfaces": "node scripts/gen-interfaces.ts",
    "start": "pnpm --filter @jobleft/ui build && node scripts/app-up.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
