{
  "name": "@jobleft/boards",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The board directory, board discovery from a careers link, user board choices and crawl planning.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "boards": "node src/cli.ts",
    "discover": "node scripts/cc-discover.ts",
    "build-directory": "node scripts/build-directory.ts"
  },
  "dependencies": {
    "@jobleft/contracts": "workspace:*",
    "@jobleft/crawler": "workspace:*",
    "@jobleft/sources-ats": "workspace:*",
    "@jobleft/static-data": "workspace:*"
  },
  "bin": {
    "jobleft-boards": "./src/cli.ts"
  },
  "files": [
    "src",
    "data",
    "scripts",
    "README.md"
  ]
}
