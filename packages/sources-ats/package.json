{
  "name": "@jobleft/sources-ats",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "ATS adapters beyond Greenhouse, Lever and Ashby (Workable, Recruitee, Personio, Teamtailor, Gem), the ATS source list, and ATS detection from a URL.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "cli": "node src/cli.ts"
  },
  "dependencies": {
    "@jobleft/contracts": "workspace:*",
    "@jobleft/parsers": "workspace:*",
    "@jobleft/crawler": "workspace:*"
  },
  "bin": {
    "jobleft-ats": "./src/cli.ts"
  }
}
