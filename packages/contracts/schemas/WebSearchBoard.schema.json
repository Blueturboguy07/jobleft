{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:WebSearchBoard",
  "title": "WebSearchBoard",
  "type": "object",
  "properties": {
    "boardId": {
      "type": "string",
      "minLength": 3
    },
    "ats": {
      "type": "string",
      "enum": [
        "greenhouse",
        "lever",
        "ashby",
        "workable",
        "recruitee",
        "personio",
        "teamtailor",
        "gem"
      ]
    },
    "board": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "company": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "results": {
      "type": "integer",
      "minimum": 1
    },
    "added": {
      "type": "boolean"
    },
    "followed": {
      "type": "boolean"
    }
  },
  "required": [
    "boardId",
    "ats",
    "board",
    "region",
    "company",
    "results",
    "added",
    "followed"
  ]
}
