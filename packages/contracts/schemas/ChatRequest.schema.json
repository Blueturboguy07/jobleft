{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:ChatRequest",
  "title": "ChatRequest",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "minItems": 1
    },
    "chatId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "preset": {
      "type": "string",
      "enum": [
        "chat",
        "fit",
        "tailor",
        "interview",
        "debrief",
        "profile",
        "browse"
      ]
    }
  },
  "required": [
    "requestId",
    "messages"
  ]
}
