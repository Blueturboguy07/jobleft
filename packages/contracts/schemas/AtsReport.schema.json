{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:AtsReport",
  "title": "AtsReport",
  "type": "object",
  "properties": {
    "grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ]
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "urgent",
              "critical",
              "optional"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "rule",
          "severity",
          "message",
          "evidence"
        ]
      }
    },
    "fileSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time, UTC (\"Z\")"
    }
  },
  "required": [
    "grade",
    "score",
    "findings",
    "fileSha256",
    "checkedAt"
  ]
}
