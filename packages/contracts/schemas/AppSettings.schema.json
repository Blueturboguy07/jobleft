{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:AppSettings",
  "title": "AppSettings",
  "type": "object",
  "properties": {
    "crawl": {
      "type": "object",
      "properties": {
        "intervalHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "catchUpOnLaunch": {
          "type": "boolean"
        },
        "runInTray": {
          "type": "boolean"
        }
      },
      "required": [
        "intervalHours",
        "catchUpOnLaunch",
        "runInTray"
      ]
    },
    "notifications": {
      "type": "object",
      "properties": {
        "reminders": {
          "type": "boolean"
        },
        "alerts": {
          "type": "boolean"
        }
      },
      "required": [
        "reminders",
        "alerts"
      ]
    }
  },
  "required": [
    "crawl",
    "notifications"
  ]
}
