{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:CoverLetter",
  "title": "CoverLetter",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "resumeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "text": {
      "type": "string"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "skill",
              "employer",
              "title",
              "school",
              "degree",
              "date",
              "duration",
              "number",
              "certification",
              "location",
              "contact",
              "other"
            ]
          },
          "where": {
            "type": "string",
            "description": "Section, item or sentence that holds it"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "fact",
          "kind",
          "where",
          "reason"
        ],
        "title": "TruthViolation"
      }
    },
    "ready": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time, UTC (\"Z\")"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time, UTC (\"Z\")"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "string"
    },
    "costMicros": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "jobId",
    "resumeId",
    "text",
    "violations",
    "ready",
    "createdAt",
    "updatedAt"
  ]
}
