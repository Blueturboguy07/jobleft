{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:JobLanguage",
  "title": "JobLanguage",
  "type": "object",
  "properties": {
    "posting": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "en",
            "nl",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "dutch": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "required",
            "preferred",
            "not_required"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "posting",
    "dutch"
  ]
}
