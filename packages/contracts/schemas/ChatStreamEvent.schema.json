{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:ChatStreamEvent",
  "title": "ChatStreamEvent",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "start"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "provider": {
          "type": "string",
          "enum": [
            "publik",
            "local",
            "custom",
            "own_key"
          ]
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "provider",
        "model"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "delta"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "proposal"
        },
        "proposal": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "tracker_status",
                      "like",
                      "unlike",
                      "hide",
                      "unhide",
                      "note_add",
                      "reminder_add",
                      "profile_edit",
                      "resume_delete",
                      "filter_save",
                      "contact_stage"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "job",
                          "resume",
                          "profile",
                          "filter",
                          "contact"
                        ]
                      },
                      "id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "summary",
                  "target"
                ]
              },
              "minItems": 1
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "description": "RFC 3339 date-time, UTC (\"Z\")"
            }
          },
          "required": [
            "id",
            "actions",
            "expiresAt"
          ],
          "title": "ActionProposal"
        }
      },
      "required": [
        "type",
        "proposal"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "done"
        },
        "incomplete": {
          "type": "boolean"
        },
        "costMicros": {
          "anyOf": [
            {
              "type": "integer",
              "description": "Integer millionths of a US dollar"
            },
            {
              "type": "null"
            }
          ]
        },
        "chatId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "incomplete",
        "costMicros",
        "chatId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "link": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://",
                  "maxLength": 4096,
                  "description": "Absolute http(s) URL"
                }
              },
              "required": [
                "label",
                "url"
              ]
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "type",
        "error"
      ]
    }
  ]
}
