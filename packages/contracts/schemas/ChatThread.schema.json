{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:ChatThread",
  "title": "ChatThread",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "title": {
      "type": "string"
    },
    "jobId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 date-time, UTC (\"Z\")"
          },
          "incomplete": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "content",
          "at"
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time, UTC (\"Z\")"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time, UTC (\"Z\")"
    }
  },
  "required": [
    "id",
    "title",
    "jobId",
    "messages",
    "createdAt",
    "updatedAt"
  ]
}
