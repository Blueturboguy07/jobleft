{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:FillRequest",
  "title": "FillRequest",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "pageUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 4096,
      "description": "Absolute http(s) URL"
    },
    "ats": {
      "type": "string",
      "enum": [
        "greenhouse",
        "lever",
        "ashby",
        "workable",
        "recruitee",
        "personio",
        "workday",
        "icims",
        "smartrecruiters",
        "oracle",
        "ukg",
        "taleo",
        "jobvite",
        "bamboohr",
        "teamtailor",
        "breezy",
        "other"
      ]
    },
    "step": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "label": {
            "type": "string",
            "maxLength": 1000
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "email",
              "tel",
              "url",
              "textarea",
              "select",
              "radio",
              "checkbox",
              "file",
              "date",
              "number",
              "unknown"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "label"
              ]
            },
            "maxItems": 500
          },
          "maxLength": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "section": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "fieldId",
          "label",
          "name",
          "kind",
          "required",
          "options",
          "maxLength",
          "section"
        ],
        "title": "FormField"
      },
      "maxItems": 500
    },
    "resumeId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "requestId",
    "pageUrl",
    "ats",
    "step",
    "fields",
    "resumeId"
  ]
}
