{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:CompanyCoverage",
  "title": "CompanyCoverage",
  "type": "object",
  "properties": {
    "companyKey": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "topContactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    }
  },
  "required": [
    "companyKey",
    "companyName",
    "count",
    "topContactIds"
  ]
}
