{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:CompanyCoverage",
  "title": "CompanyCoverage",
  "type": "object",
  "properties": {
    "companyKey": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "topContactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "required": [
    "companyKey",
    "companyName",
    "count",
    "topContactIds"
  ]
}
