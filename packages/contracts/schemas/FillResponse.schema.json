{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:FillResponse",
  "title": "FillResponse",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "jobId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "fills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "profile",
              "resume",
              "eeo",
              "saved_answer"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "exact",
              "likely"
            ]
          },
          "needsReview": {
            "type": "boolean"
          },
          "item": {
            "type": "string",
            "maxLength": 200
          },
          "topic": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "fieldId",
          "values",
          "source",
          "confidence",
          "needsReview"
        ]
      }
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "fieldId",
          "text",
          "provider"
        ]
      }
    },
    "unknownFieldIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "base64": {
            "type": "string"
          },
          "resumeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "fieldId",
          "fileName",
          "mimeType",
          "base64"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "no_value",
              "sensitive",
              "other_person",
              "open_question",
              "consent",
              "account",
              "captcha",
              "no_option",
              "file",
              "duplicate",
              "unknown"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 300
          },
          "topic": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "fieldId",
          "reason",
          "message"
        ],
        "title": "FieldNote"
      }
    },
    "draftOffer": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fieldIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provider": {
              "type": "string",
              "maxLength": 120
            },
            "local": {
              "type": "boolean"
            },
            "maxPriceMicrosPerDraft": {
              "type": "integer",
              "description": "Integer millionths of a US dollar"
            },
            "balanceMicros": {
              "anyOf": [
                {
                  "type": "integer",
                  "description": "Integer millionths of a US dollar"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "fieldIds",
            "provider",
            "local",
            "maxPriceMicrosPerDraft",
            "balanceMicros"
          ],
          "title": "DraftOffer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "requestId",
    "jobId",
    "fills",
    "drafts",
    "unknownFieldIds",
    "files",
    "warnings"
  ]
}
