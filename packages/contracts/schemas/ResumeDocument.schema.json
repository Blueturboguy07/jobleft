{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:ResumeDocument",
  "title": "ResumeDocument",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://",
                "maxLength": 4096,
                "description": "Absolute http(s) URL"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "title": "Link"
          }
        }
      },
      "required": [
        "name",
        "email",
        "phone",
        "city",
        "links"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "summary",
              "experience",
              "education",
              "skills",
              "projects",
              "certifications",
              "custom"
            ]
          },
          "title": {
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "heading": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "subheading": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "location": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "startDate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                      "description": "YYYY or YYYY-MM"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "endDate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                      "description": "YYYY or YYYY-MM"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "current": {
                  "type": "boolean"
                },
                "bullets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "heading",
                "subheading",
                "location",
                "startDate",
                "endDate",
                "current",
                "bullets",
                "tags"
              ],
              "title": "ResumeItem"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "text",
          "items"
        ],
        "title": "ResumeSection"
      }
    }
  },
  "required": [
    "header",
    "sections"
  ]
}
