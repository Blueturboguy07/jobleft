        "hasSecurityClearance": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "authorizedCountries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2"
