        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "placeId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "radiusMiles": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "text",
              "placeId",
              "radiusMiles"
            ],
            "title": "PlaceQuery"
          }
        },
        "minAnnualPayUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "companyStages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "early",
              "growth",
              "late",
              "public"
            ]
          }
        },
        "roleTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ic",
              "manager"
            ]
          }
        },
        "excludedCompanies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "jobFunctions",
        "targetTitles",
        "employmentTypes",
        "workModels",
        "levels",
        "countries",
        "places",
        "minAnnualPayUsd",
        "industries",
        "companyStages",
        "roleTypes",
        "excludedCompanies"
