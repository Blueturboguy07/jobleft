          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://",
                "maxLength": 4096,
                "description": "Absolute http(s) URL"
              },
              {
                "type": "null"
              }
            ]
          },
          "startDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "YYYY or YYYY-MM"
              },
              {
                "type": "null"
              }
            ]
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "YYYY or YYYY-MM"
              },
              {
                "type": "null"
              }
            ]
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "url",
          "startDate",
          "endDate",
          "bullets"
        ],
