          "major": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "gpa": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "startDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "YYYY or YYYY-MM"
              },
              {
                "type": "null"
              }
            ]
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "YYYY or YYYY-MM"
              },
              {
                "type": "null"
              }
            ]
          },
          "current": {
            "type": "boolean"
          },
          "achievements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coursework": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
