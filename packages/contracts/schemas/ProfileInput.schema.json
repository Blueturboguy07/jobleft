            {
              "type": "null"
            }
          ]
        },
        "veteran": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "decline"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "gender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lgbtq": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "decline"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "race": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hispanicOrLatino": {
          "anyOf": [
            {
              "type": "string",
