        "targetTitles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "employmentTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "full_time",
              "part_time",
              "contract",
              "internship",
              "temporary",
              "other"
            ]
          }
        },
        "workModels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "onsite",
              "hybrid",
              "remote"
            ]
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "intern_new_grad",
              "entry",
              "mid",
              "senior",
              "lead_staff",
              "director_exec"
            ]
