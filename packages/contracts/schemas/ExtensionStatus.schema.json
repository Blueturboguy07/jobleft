{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:ExtensionStatus",
  "title": "ExtensionStatus",
  "type": "object",
  "properties": {
    "paired": {
      "type": "boolean"
    },
    "appVersion": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profileComplete": {
      "type": "boolean"
    },
    "missingProfileFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "paired",
    "appVersion",
    "protocolVersion",
    "profileComplete",
    "missingProfileFields"
  ]
}
