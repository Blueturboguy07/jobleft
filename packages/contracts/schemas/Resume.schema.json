{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobleft:contracts:Resume",
  "title": "Resume",
  "description": "A base resume or a tailored version",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "targetTitle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "isPrimary": {
      "type": "boolean"
    },
    "kind": {
      "type": "string",
      "enum": [
        "base",
        "tailored"
      ]
    },
    "baseResumeId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "jobId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "file": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fileName": {
              "type": "string"
            },
            "mimeType": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "fileName",
            "mimeType",
            "bytes",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "document": {
      "type": "object",
      "properties": {
        "header": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "phone": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "city": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://",
                    "maxLength": 4096,
                    "description": "Absolute http(s) URL"
                  }
                },
                "required": [
                  "label",
                  "url"
                ],
                "title": "Link"
              }
            }
          },
          "required": [
            "name",
            "email",
            "phone",
            "city",
            "links"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "kind": {
                "type": "string",
                "enum": [
                  "summary",
                  "experience",
                  "education",
                  "skills",
                  "projects",
                  "certifications",
                  "custom"
                ]
              },
              "title": {
                "type": "string"
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "heading": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "subheading": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "location": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "startDate": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                          "description": "YYYY or YYYY-MM"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "endDate": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                          "description": "YYYY or YYYY-MM"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "current": {
                      "type": "boolean"
                    },
                    "bullets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "heading",
                    "subheading",
                    "location",
                    "startDate",
                    "endDate",
                    "current",
                    "bullets",
                    "tags"
                  ],
                  "title": "ResumeItem"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "text",
              "items"
            ],
            "title": "ResumeSection"
          }
        }
      },
      "required": [
        "header",
        "sections"
      ],
      "title": "ResumeDocument"
    },
    "importReport": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "counts": {
              "type": "object",
              "properties": {
                "jobs": {
                  "type": "integer",
                  "minimum": 0
                },
                "bullets": {
                  "type": "integer",
                  "minimum": 0
                },
                "skills": {
                  "type": "integer",
                  "minimum": 0
                },
                "education": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "jobs",
                "bullets",
                "skills",
                "education"
              ]
            },
            "unreadSections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outcome": {
              "type": "string",
              "enum": [
                "ok",
                "partial",
                "failed"
              ]
            },
            "failure": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "empty_file",
                    "too_large",
                    "image_only",
                    "password_protected",
                    "unsupported_type",
                    "corrupt"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "counts",
            "unreadSections",
            "warnings",
            "outcome",
            "failure"
          ],
          "title": "ImportReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "atsReport": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "grade": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "F"
              ]
            },
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "rule": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "urgent",
                      "critical",
                      "optional"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "rule",
                  "severity",
                  "message",
                  "evidence"
                ]
              }
            },
            "fileSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time",
              "description": "RFC 3339 date-time, UTC (\"Z\")"
            }
          },
          "required": [
            "grade",
            "score",
            "findings",
            "fileSha256",
            "checkedAt"
          ],
          "title": "AtsReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time, UTC (\"Z\")"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time, UTC (\"Z\")"
    }
  },
  "required": [
    "id",
    "name",
    "targetTitle",
    "isPrimary",
    "kind",
    "baseResumeId",
    "jobId",
    "version",
    "file",
    "document",
    "importReport",
    "atsReport",
    "createdAt",
    "updatedAt"
  ]
}
