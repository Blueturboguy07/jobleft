{
  "name": "@jobleft/resume",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Resume import, truth-gated tailoring, keyword gaps, cover letters, the ATS check, and PDF and Word export.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "cli": "node src/cli/main.ts",
    "fixtures": "node test/fixtures/src/make-fixtures.ts"
  },
  "dependencies": {
    "@jobleft/ai-engine": "workspace:*",
    "@jobleft/contracts": "workspace:*",
    "@jobleft/static-data": "workspace:*",
    "unpdf": "1.8.1"
  },
  "bin": {
    "jobleft-resume": "./src/cli/main.ts"
  }
}
