{
  "name": "@jobleft/crawler",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Crawler core: the Source adapter contract, the polite HTTP client, the per-host pacer, robots.txt, conditional requests, dedupe, close-vanished logic, the crawl store, the scheduler and the jobleft-crawl CLI.",
  "exports": {
    ".": "./src/index.ts",
    "./testkit": "./testkit/mock-boards.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "cli": "node src/cli.ts",
    "mock-boards": "node testkit/mock-boards.ts",
    "crawl": "node src/cli.ts crawl",
    "verify": "node src/cli.ts verify",
    "report": "node src/cli.ts report",
    "search": "node src/cli.ts search"
  },
  "dependencies": {
    "@jobleft/contracts": "workspace:*",
    "@jobleft/parsers": "workspace:*"
  },
  "bin": {
    "jobleft-crawl": "./src/cli.ts"
  }
}
