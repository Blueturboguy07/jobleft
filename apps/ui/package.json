{
  "name": "@jobleft/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The desktop UI (React 18 and Ant Design 5), plus a mock of the local API for building and checking the UI on its own.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "demo": "node mock/run.ts",
    "api": "node mock/server.ts",
    "stand-in:boards": "node mock/boards-server.ts",
    "stand-in:publik": "node mock/publik.ts",
    "stand-in:ai": "node mock/ai.ts",
    "ctl": "node mock/ctl.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/titillium-web": "5.3.0",
    "@jobleft/contracts": "workspace:*",
    "antd": "5.29.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "vite": "7.3.6"
  }
}
