{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jobleft",
  "mainBinaryName": "jobleft",
  "version": "0.1.11",
  "identifier": "com.publik.jobleft",
  "build": {
    "frontendDist": "../dist-placeholder"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/server/": "server/",
      "resources/ui/": "ui/",
      "resources/publik-app-token.txt": "publik-app-token.txt"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RTA1MTVDNzc5MTJCRDAKUldUUUs1RjNYRkhnOWRTQ2UwaGJ5Vm5vTTRwV2d5NzNNZEQrWWYxSU1abnRnWEthc3FkWVJjWXYK",
      "endpoints": [
        "https://publikhq.com/api/updates/jobleft/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
